# Copy to sync-agent.env (never commit it) and fill in. Used by run-sync-agent.sh.
PORTAL_URL=https://plot-portal-api.northh.workers.dev
SYNC_TOKEN=put-the-worker-SYNC_TOKEN-here

# Read the game log from Crafty's API ...
CRAFTY_URL=https://127.0.0.1:8443
CRAFTY_TOKEN=put-a-crafty-api-key-here
CRAFTY_SERVER_ID=put-the-server-uuid-here
CRAFTY_INSECURE=1

# ... or from the server's log file instead (then the three CRAFTY_* lines above are not needed for pushing):
# LOG_FILE=/var/opt/minecraft/crafty/crafty-4/servers/<uuid>/logs/latest.log

STATE_FILE=./sync-agent-state.json
# CHUNK_SIZE=900
# CHUNK_DELAY_MS=150
